{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowJs": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "next/navigation": ["./src/demo/adapters/navigation.tsx"],
      "next/link": ["./src/demo/adapters/link.tsx"],
      "next/image": ["./src/demo/adapters/image.tsx"],
      "next/script": ["./src/demo/adapters/script.tsx"],
      "@/lib/supabase/client": ["./src/demo/client.ts"],
      "@/lib/supabase/read-prefetch": ["./src/demo/read-prefetch.ts"],
      "@/components/auth/captcha-field": ["./src/demo/adapters/captcha.tsx"],
      "@/*": ["./src/studio/*"]
    }
  },
  "include": ["src/main.tsx", "src/demo/**/*.ts", "src/demo/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
